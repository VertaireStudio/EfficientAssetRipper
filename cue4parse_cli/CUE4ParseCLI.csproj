<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 is forced by the dated CUE4Parse builds (1.2.2.202607 onward),
         which are the only ones defining EGame.GAME_UE5_7 — UE 5.7 bumped the
         package LegacyFileVersion to -9, which every earlier build rejects as
         "Can't load legacy UE3 file". They ship net10.0-only.
         Publishes are self-contained, so users still need no .NET install. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CUE4ParseCLI</AssemblyName>
    <RootNamespace>CUE4ParseCLI</RootNamespace>
    <!-- Export throughput knobs: N parallel export workers allocate heavily
         (decoded texture buffers, serialized UObject graphs) and Server GC
         scales FGH across cores on both win-x64 and linux-x64. Higher
         steady-state RAM is the accepted tradeoff. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Explicit (default-on since .NET 8) so a future RuntimeTarget downgrade
         does not silently lose profile-guided optimization. -->
    <TieredPGO>true</TieredPGO>
    <!-- The CLI never renders locale-formatted text and only ingests
         parent-supplied JSON; skipping ICU on Linux avoids the runtime ICU
         initializer entirely and shaves mount-time startup both platforms. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publish-only: precompile framework + app assemblies (publishes always
         pass -r <rid>). Startup matters because every GUI session spawns this
         process fresh before the mount can begin. Keep single-file publish
         uncompressed (default) — R2R plus EnableCompressionInSingleFile
         regresses startup by re-decompressing the composite image every run
         (dotnet/runtime#101866). Binary size grows roughly 30-50%. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned, not floating: a "*" range silently resolved to the newest
         net8-compatible build (1.2.2) and shipped a CLI that could not read
         UE 5.7 at all. Bump deliberately, and re-run the loose-file mount
         check first: 1.2.2.202608 has identical EGame coverage but remounts
         loose files under a synthetic "<GameDir>" root and lists them twice
         (Rocket League: 19584 -> 21204 entries, all duplicates). -->
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202607" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <!-- The SkiaSharp meta-package CUE4Parse-Conversion pulls in ships
         Windows/macOS native assets only; without a Linux native asset the
         texture decode path fails on Linux with "Unable to load
         libSkiaSharp". NoDependencies avoids a hard fontconfig dependency
         (the CLI doesn't render text). Linux-only payloads — irrelevant on
         a Windows publish, matching version pinned to CUE4Parse-Conversion's
         SkiaSharp (2.88.9). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <!-- GPU texture decode (BC1-BC7/ASTC via the Vulkan fixed-function sampler,
         see GpuTextureDecoder.cs). Pure P/Invoke against the platform loader:
         vulkan-1.dll on Windows, libvulkan.so.1 on Linux — both ship with GPU
         drivers, and absence just triggers the CPU fallback at runtime. -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
  </ItemGroup>
</Project>
